<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iot_device_tree" model="ir.ui.view">
        <field name="name">iot.device.tree</field>
        <field name="model">iot.device</field>
        <field name="arch" type="xml">
            <list create="0" class="iot_list" decoration-muted="not online">
                <field name="name"/>
                <field name="location_detail"/>
                <field name="switch_id_display" string="Switch ID" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="department_id" optional="hide"/>
                <field name="location_id"/>
                <field name="relay_state" string="Confirmed State" widget="badge" decoration-success="relay_state == 'on'" decoration-info="relay_state == 'off'" decoration-warning="relay_state == 'unknown'"/>
                <field name="delay_active" invisible="1"/>
                <field name="delay_remaining_minutes" string="Delay Remaining" widget="delay_countdown"/>
                <field name="online"/>
                <field name="desired_relay_state" string="Requested" optional="hide"/>
                <field name="relay_command_state" string="Command" widget="badge"/>
                <field name="firmware_version" string="Firmware" optional="hide"/>
                <field name="mqtt_route" string="Network" widget="badge"/>
                <field name="total_on_hours" string="Accumulated ON (Hours)" optional="hide"/>
                <field name="last_seen"/>
                <button name="action_turn_on" groups="iot_control_center.group_iot_operator" type="object" string="ON" class="iot_toggle_btn iot_toggle_left iot_toggle_on_active" invisible="relay_state != 'on'"/>
                <button name="action_turn_on" groups="iot_control_center.group_iot_operator" type="object" string="ON" class="iot_toggle_btn iot_toggle_left iot_toggle_passive" invisible="relay_state == 'on'"/>
                <button name="action_turn_off" groups="iot_control_center.group_iot_operator" type="object" string="OFF" class="iot_toggle_btn iot_toggle_right iot_toggle_off_active" invisible="relay_state != 'off'"/>
                <button name="action_turn_off" groups="iot_control_center.group_iot_operator" type="object" string="OFF" class="iot_toggle_btn iot_toggle_right iot_toggle_passive" invisible="relay_state == 'off'"/>
                <button name="action_delay_toggle" groups="iot_control_center.group_iot_operator" type="object" string="Delay" class="iot_toggle_btn iot_toggle_single iot_toggle_on_active" invisible="delay_active != True"/>
                <button name="action_delay_toggle" groups="iot_control_center.group_iot_operator" type="object" string="Delay" class="iot_toggle_btn iot_toggle_single iot_toggle_passive" invisible="delay_active == True"/>
            </list>
        </field>
    </record>

    <record id="view_iot_device_kanban" model="ir.ui.view">
        <field name="name">iot.device.kanban</field>
        <field name="model">iot.device</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile iot_device_cards" create="0">
                <field name="name"/>
                <field name="switch_id_display"/>
                <field name="relay_state"/>
                <field name="delay_active"/>
                <field name="delay_remaining_minutes"/>
                <field name="delay_duration_minutes"/>
                <field name="online"/>
                <field name="firmware_version"/>
                <field name="total_on_hours"/>
                <field name="relay_command_state"/>
                <field name="desired_relay_state"/>
                <field name="location_id"/>
                <field name="location_detail"/>
                <field name="last_seen"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click iot_device_card iot_relay_card">
                            <div class="iot_device_identity">
                                <h3 t-att-title="record.name.value"><field name="name"/></h3>
                                <span t-if="record.online.raw_value" class="iot_status_pill">Connected</span>
                                <span t-else="" class="iot_status_pill iot_status_pill_off">No Recent Contact</span>
                            </div>
                            <div class="iot_relay_location_detail" t-att-title="record.location_detail.value || ''"><field name="location_detail"/></div>
                            <div class="iot_device_meta iot_relay_location" t-att-title="record.location_id.value || ''"><field name="location_id"/></div>
                            <div class="iot_device_meta">
                                <span>Switch ID: </span><field name="switch_id_display"/>
                            </div>
                            <div class="iot_relay_state_panel">
                                <div class="iot_state_row"><span>Confirmed State: </span><field name="relay_state" widget="badge" decoration-success="relay_state == 'on'"/></div>
                                <div class="iot_state_row" t-if="record.relay_command_state.raw_value != 'idle'"><span>Command: </span><field name="relay_command_state" widget="badge" decoration-warning="relay_command_state == 'pending'" decoration-danger="relay_command_state == 'timeout'"/></div>
                                <div class="iot_state_row" t-if="record.relay_command_state.raw_value == 'pending'"><span>Requested State: </span><field name="desired_relay_state" widget="badge"/></div>
                            </div>
                            <div class="iot_state_row" t-if="record.delay_active.raw_value">
                                <span>Delay Remaining: </span><field name="delay_remaining_minutes" widget="delay_countdown"/>
                            </div>
                            <div class="iot_device_meta">
                                <span>Last contact: </span><field name="last_seen"/>
                            </div>
                            <div class="iot_toggle_group">
                                <button type="object" name="action_turn_on" groups="iot_control_center.group_iot_operator" class="iot_toggle_btn iot_toggle_left iot_toggle_on_active" invisible="relay_state != 'on'">ON</button>
                                <button type="object" name="action_turn_on" groups="iot_control_center.group_iot_operator" class="iot_toggle_btn iot_toggle_left iot_toggle_passive" invisible="relay_state == 'on'">ON</button>
                                <button type="object" name="action_turn_off" groups="iot_control_center.group_iot_operator" class="iot_toggle_btn iot_toggle_right iot_toggle_off_active" invisible="relay_state != 'off'">OFF</button>
                                <button type="object" name="action_turn_off" groups="iot_control_center.group_iot_operator" class="iot_toggle_btn iot_toggle_right iot_toggle_passive" invisible="relay_state == 'off'">OFF</button>
                                <button type="object" name="action_delay_toggle" groups="iot_control_center.group_iot_operator" class="iot_toggle_btn iot_toggle_single iot_toggle_on_active" invisible="delay_active != True">Delay</button>
                                <button type="object" name="action_delay_toggle" groups="iot_control_center.group_iot_operator" class="iot_toggle_btn iot_toggle_single iot_toggle_passive" invisible="delay_active == True">Delay</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_iot_device_form" model="ir.ui.view">
        <field name="name">iot.device.form</field>
        <field name="model">iot.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_unbind" type="object" string="Unbind" class="btn-secondary" confirm="Unbind this switch from current company?"/>
                    <button name="action_turn_on" groups="iot_control_center.group_iot_operator" type="object" string="Turn On" class="btn-primary" invisible="relay_state != 'on'"/>
                    <button name="action_turn_on" groups="iot_control_center.group_iot_operator" type="object" string="Turn On" class="btn-secondary" invisible="relay_state == 'on'"/>
                    <button name="action_turn_off" groups="iot_control_center.group_iot_operator" type="object" string="Turn Off" class="btn-primary" invisible="relay_state != 'off'"/>
                    <button name="action_turn_off" groups="iot_control_center.group_iot_operator" type="object" string="Turn Off" class="btn-secondary" invisible="relay_state == 'off'"/>
                    <button name="action_delay_toggle" groups="iot_control_center.group_iot_operator" type="object" string="Delay Switch" class="btn-primary" invisible="delay_active != True"/>
                    <button name="action_delay_toggle" groups="iot_control_center.group_iot_operator" type="object" string="Delay Switch" class="btn-secondary" invisible="delay_active == True"/>
                    <button name="action_reset_uptime" type="object" string="Reset Accumulated Time"/>
                    <button name="action_sync_network_config" type="object" string="Sync Internal Network"/>
                    <field name="relay_state" widget="statusbar" statusbar_visible="unknown,off,on" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="switch_id_display" readonly="1" string="Switch ID"/>
                            <field name="serial" readonly="1"/>
                            <field name="module_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="department_id"/>
                            <field name="location_id"/>
                            <field name="location_detail"/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="online" readonly="1"/>
                            <field name="last_seen" readonly="1"/>
                            <field name="desired_relay_state" readonly="1"/>
                            <field name="relay_command_state" readonly="1" widget="badge"/>
                            <field name="last_command_confirmed_at" readonly="1"/>
                            <field name="max_continuous_on_minutes"/>
                            <field name="safety_critical"/>
                            <field name="delay_duration_minutes"/>
                            <field name="delay_active" readonly="1"/>
                            <field name="delay_started_at" readonly="1"/>
                            <field name="delay_end_at" readonly="1"/>
                            <field name="delay_remaining_minutes" readonly="1" widget="delay_countdown"/>
                            <field name="firmware_version" readonly="1"/>
                            <field name="firmware_hardware_profile" readonly="1"/>
                            <field name="flash_real_size_bytes" readonly="1"/>
                            <field name="free_heap_bytes" readonly="1"/>
                            <field name="mqtt_active_host" readonly="1"/>
                            <field name="mqtt_route" readonly="1" widget="badge"/>
                            <field name="network_config_dirty" readonly="1"/>
                            <field name="firmware_target_version" readonly="1"/>
                            <field name="firmware_upgrade_state" readonly="1"/>
                            <field name="firmware_upgrade_requested_at" readonly="1"/>
                            <field name="firmware_upgrade_completed_at" readonly="1"/>
                            <field name="total_on_hours" readonly="1"/>
                            <field name="schedule_sync_state" readonly="1"/>
                            <field name="schedule_dirty" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="auth_token" readonly="1" password="True"/>
                        <field name="last_command_at" readonly="1"/>
                        <field name="last_command_id" readonly="1"/>
                        <field name="last_command_payload" readonly="1"/>
                        <field name="schedule_version" readonly="1"/>
                        <field name="schedule_applied_version" readonly="1"/>
                        <field name="schedule_last_push_at" readonly="1"/>
                        <field name="schedule_last_sync_at" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_iot_device" model="ir.actions.act_window">
        <field name="name">Switches</field>
        <field name="res_model">iot.device</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('company_id', '!=', False)]</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="action_iot_device_cards" model="ir.actions.act_window">
        <field name="name">Switch Cards</field>
        <field name="res_model">iot.device</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('company_id', '!=', False)]</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="action_iot_device_bind_wizard" model="ir.actions.act_window">
        <field name="name">Bind Switch by ID</field>
        <field name="res_model">iot.device.bind.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_iot_root" name="IoT Control Center" sequence="10" groups="base.group_erp_manager" web_icon="iot_control_center,static/description/icon.png"/>
    <menuitem id="menu_iot_mode_cards" name="Workspaces" parent="menu_iot_root" sequence="10" groups="base.group_erp_manager"/>
    <menuitem id="menu_iot_mode_detailed" name="Device Management" parent="menu_iot_root" sequence="20" groups="base.group_erp_manager"/>
    <menuitem id="menu_iot_switch_cards" name="Switch" parent="menu_iot_mode_cards" action="action_iot_device_cards" sequence="10" groups="base.group_erp_manager"/>
    <menuitem id="menu_iot_switch_root" name="Switch" parent="menu_iot_mode_detailed" sequence="10" groups="base.group_erp_manager"/>
    <menuitem id="menu_iot_device" name="Switch" parent="menu_iot_switch_root" action="action_iot_device" sequence="10" groups="base.group_erp_manager"/>
    <menuitem id="menu_iot_device_bind" name="Bind by ID" parent="menu_iot_switch_root" action="action_iot_device_bind_wizard" sequence="11" groups="base.group_erp_manager"/>
</odoo>
