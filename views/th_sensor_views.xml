<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iot_th_sensor_list" model="ir.ui.view">
        <field name="name">iot.th.sensor.list</field>
        <field name="model">iot.th.sensor</field>
        <field name="arch" type="xml">
            <list create="0" class="iot_list"
                  decoration-muted="not online"
                  decoration-danger="online and (last_temperature &lt; effective_temperature_low or last_temperature &gt; effective_temperature_high or last_humidity &lt; effective_humidity_low or last_humidity &gt; effective_humidity_high)">
                <field name="display_name" string="Probe"/>
                <field name="name" optional="hide"/>
                <field name="technical_code" optional="hide"/>
                <field name="group_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="location_id"/>
                <field name="location_detail" optional="hide"/>
                <field name="online"/>
                <field name="last_temperature"/>
                <field name="last_humidity"/>
                <field name="last_battery_voltage" optional="hide"/>
                <field name="last_reported_at"/>
                <field name="reading_count" optional="hide"/>
                <field name="keep_full_history" optional="hide"/>
                <button name="action_open_readings" type="object" string="Trend" icon="fa-line-chart"/>
                <field name="effective_temperature_low" column_invisible="1"/>
                <field name="effective_temperature_high" column_invisible="1"/>
                <field name="effective_humidity_low" column_invisible="1"/>
                <field name="effective_humidity_high" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_iot_th_sensor_kanban" model="ir.ui.view">
        <field name="name">iot.th.sensor.kanban</field><field name="model">iot.th.sensor</field>
        <field name="arch" type="xml"><kanban create="0" class="iot_device_cards">
            <field name="display_name"/><field name="online"/><field name="last_reported_at"/>
            <field name="last_temperature"/><field name="last_humidity"/><field name="location_id"/>
            <templates><t t-name="card"><div class="iot_device_card">
                <div class="iot_device_identity"><h3><field name="display_name"/></h3>
                    <span t-if="record.online.raw_value" class="iot_status_pill">Connected</span>
                    <span t-else="" class="iot_status_pill iot_status_pill_off">No Recent Contact</span></div>
                <div class="iot_device_meta"><field name="location_id"/></div>
                <div class="iot_sensor_readings" t-if="record.last_reported_at.raw_value">
                    <div><strong><field name="last_temperature"/> °C</strong><small>Temperature</small></div>
                    <div><strong><field name="last_humidity"/> %</strong><small>Relative humidity</small></div>
                </div>
                <p t-else="" class="iot_device_meta">Waiting for the first reading</p>
                <p class="iot_device_meta"><span>Last reading: </span><field name="last_reported_at"/></p>
                <button name="action_open_readings" type="object" class="btn btn-primary">View trend</button>
            </div></t></templates>
        </kanban></field>
    </record>

    <record id="view_iot_th_sensor_form" model="ir.ui.view">
        <field name="name">iot.th.sensor.form</field>
        <field name="model">iot.th.sensor</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_readings" type="object" string="Trend" class="btn-primary"/>
                    <button name="action_unbind" type="object" string="Unbind" class="btn-secondary" confirm="Unbind this node from current company?"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="display_name" string="Chart Legend Label" readonly="1"/>
                            <field name="technical_code" readonly="1"/>
                            <field name="node_id" readonly="1" invisible="1"/>
                            <field name="probe_code" readonly="1" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="group_id"/>
                            <field name="location_id"/>
                            <field name="location_detail"/>
                            <field name="active"/>
                            <field name="keep_full_history"/>
                        </group>
                        <group>
                            <field name="online" readonly="1"/>
                            <field name="last_temperature" readonly="1"/>
                            <field name="last_humidity" readonly="1"/>
                            <field name="last_battery_voltage" readonly="1"/>
                            <field name="last_reported_at" readonly="1"/>
                            <field name="reading_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Thresholds">
                        <field name="temperature_low"/>
                        <field name="temperature_high"/>
                        <field name="humidity_low"/>
                        <field name="humidity_high"/>
                        <field name="threshold_source" readonly="1"/>
                        <field name="effective_temperature_low" readonly="1"/>
                        <field name="effective_temperature_high" readonly="1"/>
                        <field name="effective_humidity_low" readonly="1"/>
                        <field name="effective_humidity_high" readonly="1"/>
                    </group>
                    <group string="Statistics Period">
                        <field name="stats_window_hours"/>
                        <field name="avg_temperature" readonly="1"/>
                        <field name="min_temperature" readonly="1"/>
                        <field name="max_temperature" readonly="1"/>
                        <field name="avg_humidity" readonly="1"/>
                        <field name="min_humidity" readonly="1"/>
                        <field name="max_humidity" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_iot_th_sensor" model="ir.actions.act_window">
        <field name="name">Sensors</field>
        <field name="res_model">iot.th.sensor</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('company_id', '!=', False)]</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="action_iot_th_sensor_bind_wizard" model="ir.actions.act_window">
        <field name="name">Bind Node by ID</field>
        <field name="res_model">iot.th.sensor.bind.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_iot_th_sensor" name="Sensors" parent="menu_iot_environment_root" action="action_iot_th_sensor" sequence="20" groups="base.group_erp_manager"/>
    <menuitem id="menu_iot_th_sensor_bind" name="Bind Node by ID" parent="menu_iot_environment_root" action="action_iot_th_sensor_bind_wizard" sequence="21" groups="base.group_erp_manager"/>
</odoo>
