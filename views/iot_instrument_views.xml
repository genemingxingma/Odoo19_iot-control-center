<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_instrument_kanban" model="ir.ui.view"><field name="name">iot.instrument.kanban</field><field name="model">iot.instrument</field><field name="arch" type="xml">
        <kanban class="iot_instrument_cards"><field name="name"/><field name="device_id"/><field name="kind"/><field name="location_detail"/><field name="online"/><field name="status_fresh"/><field name="valid_a"/><field name="settings_ready"/>
            <templates><t t-name="card"><div class="iot_instrument_card"><div class="d-flex justify-content-between gap-2"><strong><field name="name"/></strong><span t-if="record.online.raw_value" class="badge text-bg-success">Connected</span><span t-else="" class="badge text-bg-secondary">No recent contact</span></div>
                <div class="text-muted small mt-2"><field name="device_id"/></div><div class="text-muted mt-1" style="min-height:3em"><field name="location_detail"/></div>
                <div class="mb-3"><field name="state" widget="badge"/></div>
                <div t-if="record.kind.raw_value === 'heater'" class="d-flex gap-4 mb-3"><div>Liquid Temperature<br/><strong t-if="record.valid_a.raw_value and record.online.raw_value and record.status_fresh.raw_value"><field name="temperature_a"/> C</strong><strong t-else="">Unavailable</strong></div><div>Stored Temperature<br/><strong t-if="record.settings_ready.raw_value"><field name="applied_target_a"/> C</strong><strong t-else="">Not set</strong></div></div>
                <div t-if="record.kind.raw_value === 'washer'" class="iot_program_card_summary"><div><field name="program_count"/> <span>programs in sync list</span></div><field name="program_sync_state" widget="badge"/></div>
                <div class="text-muted small">Last contact: <field name="last_seen"/></div>
                <div class="iot_instrument_card_actions"><button t-if="record.kind.raw_value === 'washer'" name="action_open_program_selection" type="object" string="Select Programs" class="btn btn-primary"/><button name="action_history" type="object" string="View History" class="btn btn-secondary"/></div>
                </div>
            </t></templates>
        </kanban>
    </field></record>
    <record id="view_instrument_list" model="ir.ui.view"><field name="name">iot.instrument.list</field><field name="model">iot.instrument</field><field name="arch" type="xml"><list class="iot_list"><field name="name"/><field name="device_id"/><field name="location_detail"/><field name="kind" optional="hide"/><field name="online"/><field name="state" widget="badge"/><field name="program_count" column_invisible="context.get('default_kind') != 'washer'"/><field name="program_sync_state" widget="badge" column_invisible="context.get('default_kind') != 'washer'"/><field name="last_seen"/><field name="firmware" optional="hide"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_instrument_form" model="ir.ui.view"><field name="name">iot.instrument.form</field><field name="model">iot.instrument</field><field name="arch" type="xml"><form class="iot_instrument_form">
        <header><button name="action_stop" type="object" string="Stop Device" class="btn-danger" groups="iot_control_center.group_iot_operator" confirm="Request a stop? Verify the device has stopped before opening or servicing it."/><field name="state" widget="statusbar"/></header>
        <sheet><div class="oe_button_box" name="button_box"><button name="action_open_program_library" type="object" string="Program Library" class="oe_stat_button" icon="fa-list-ol" invisible="kind != 'washer'"/><button name="action_history" type="object" string="History" class="oe_stat_button" icon="fa-line-chart"/></div>
            <div class="oe_title"><h1><field name="name" placeholder="Name this instrument"/></h1><field name="location_detail" placeholder="Room and equipment location"/></div>
            <group><group><field name="device_id"/><field name="kind" readonly="id"/><field name="company_id" readonly="id"/><field name="active" invisible="1"/></group><group><field name="online"/><field name="last_seen"/></group></group>
            <div class="alert alert-warning" invisible="online">No recent device contact. Displayed state may be stale; queued commands expire after two minutes.</div>
            <notebook>
                <page string="Temperature Control" invisible="kind != 'heater'">
                    <group><group string="Device Feedback"><field name="valid_a"/><field name="temperature_a" invisible="not valid_a or not status_fresh"/><field name="heating_enabled"/><field name="heater_demand"/><field name="heater_output"/><field name="communication_pause"/><field name="fault_a"/><field name="chip_id"/><field name="device_ip"/></group><group string="Temperature Settings"><field name="target_a"/><field name="settings_ready"/><field name="applied_target_a" invisible="not settings_ready"/><field name="settings_pending"/></group></group>
                    <div class="alert alert-info" invisible="not settings_pending">Requested settings differ from the last device confirmation. Save changes, then send settings and wait for confirmation.</div>
                    <div class="iot_form_actions"><button name="action_set_temperature" type="object" string="Send Temperature Settings" class="btn-primary" groups="iot_control_center.group_iot_operator"/><button name="action_alarms" type="object" string="Heater Alarms" class="btn-secondary"/></div>
                    <details class="iot_help_details"><summary>Heating Protection</summary>
                    <group string="Heating Protection"><field name="rise_window_s" readonly="not id" groups="iot_control_center.group_iot_manager"/><field name="minimum_rise_c" readonly="not id" groups="iot_control_center.group_iot_manager"/><field name="applied_rise_window_s" invisible="not settings_ready"/><field name="applied_minimum_rise_c" invisible="not settings_ready"/><field name="dropped_observations"/></group>
                    <p>Targets and protection settings are stored on the device for offline use. Downloading does not start heating. Change protection settings only while stopped.</p>
                    <p>No level sensor is installed. Heating stops and an alarm latches if temperature rises by less than 1 C during 600 seconds of actual heating (default), or if the probe fails. Exactly 1 C does not trigger this alarm. Check liquid, probe placement and heater before restarting locally.</p>
                    <p>Heater Output is the controller output, not independent proof of power or heat. Offline storage retains recent temperature samples and preserves alarms; overwritten samples are counted.</p>
                    </details>
                </page>
                <page string="Programs and Sync" name="programs" invisible="kind != 'washer'">
                    <div class="iot_workflow_strip"><span><b>1</b> Release a program</span><span><b>2</b> Select programs here</span><span><b>3</b> Wait for device confirmation</span></div>
                    <group>
                        <group string="Choose What to Download">
                            <field name="program_scope" widget="radio"/>
                            <field name="assigned_program_ids" widget="many2many_tags" invisible="program_scope != 'selected'" required="program_scope == 'selected'" domain="[('company_id','=',company_id),('state','=','released')]" options="{'no_create': True}"/>
                        </group>
                        <group string="Device Confirmation"><field name="program_sync_state" widget="badge"/><field name="program_count"/><field name="catalog_sync_enabled" invisible="1"/></group>
                    </group>
                    <div class="iot_form_hint">Saving updates this washer's download list. New released revisions follow automatically; archived programs are removed. An offline washer keeps its existing local list.</div>
                    <div class="iot_form_actions"><button name="action_apply_programs" type="object" string="Save Program Selection" class="btn-primary" groups="iot_control_center.group_iot_operator"/><button name="action_open_program_library" type="object" string="Open Program Library" class="btn-secondary"/></div>
                    <separator string="Programs for This Washer"/>
                    <field name="effective_program_ids" nolabel="1" readonly="1"><list create="0" delete="0"><field name="name"/><field name="device_label"/><field name="revision"/><field name="state" widget="badge"/></list></field>
                    <p class="text-muted mt-3">Programs are downloaded while idle. Starting and continuing a run require confirmation at the instrument.</p>
                    <group string="Device Pump Settings"><field name="pump_a_seconds"/><field name="pump_b_seconds"/><field name="pump_settings_revision"/><field name="status_sampled_at"/></group>
                    <p>Times are reported by the washer, not sent by programs. Zero means not set. Adjust them on the device; offline values may be stale.</p>
                    <details class="iot_help_details"><summary>Temperature and Legacy Devices</summary><group><field name="washer_temperature_valid"/><field name="washer_temperature" invisible="not washer_temperature_valid or not status_fresh"/></group><group invisible="catalog_sync_enabled"><field name="recipe_id" domain="[('state','=','released'),('company_id','=',company_id)]"/><button name="action_send_recipe" type="object" string="Send Program" groups="iot_control_center.group_iot_operator"/></group></details>
                </page>
                <page string="Command Delivery"><field name="command_ids" readonly="1"><list create="0" delete="0"><field name="create_date"/><field name="name"/><field name="state"/><field name="attempts"/><field name="expires_at"/><field name="acknowledged_at"/></list></field></page>
                <page string="Commissioning and Firmware" groups="iot_control_center.group_iot_manager"><group><field name="uid"/><field name="firmware"/><field name="hardware"/></group><p>Keep the existing thermal cutoff and mechanical safety interlocks. Do not commission hardware until wiring and output polarity have been verified.</p><button name="action_credentials" type="object" string="Register Device Token"/><group><field name="release_id" domain="[('kind','=',kind),('company_id','=',company_id)]"/></group><button name="action_ota" type="object" string="Request Firmware Update" confirm="The instrument must be idle. Send this signed firmware update?"/><field name="status_json" readonly="1"/></page>
            </notebook>
        </sheet>
    </form></field></record>
    <record id="action_buffer_heaters" model="ir.actions.act_window"><field name="name">Buffer Heaters</field><field name="res_model">iot.instrument</field><field name="view_mode">kanban,list,form</field><field name="domain">[('kind','=','heater')]</field><field name="context">{'default_kind':'heater'}</field></record>
    <record id="view_instrument_freshness" model="ir.ui.view">
        <field name="name">iot.instrument.freshness</field><field name="model">iot.instrument</field>
        <field name="inherit_id" ref="view_instrument_form"/><field name="arch" type="xml">
            <field name="last_seen" position="after"><field name="status_sampled_at"/><field name="status_fresh" invisible="1"/></field>
            <xpath expr="//div[contains(@class,'alert-warning')]" position="attributes"><attribute name="invisible">online and status_fresh</attribute></xpath>
        </field>
    </record>
    <record id="action_array_washers" model="ir.actions.act_window"><field name="name">Array Washers</field><field name="res_model">iot.instrument</field><field name="view_mode">kanban,list,form</field><field name="domain">[('kind','=','washer')]</field><field name="context">{'default_kind':'washer'}</field></record>
    <record id="view_instrument_reading_search" model="ir.ui.view"><field name="name">iot.instrument.reading.search</field><field name="model">iot.instrument.reading</field><field name="arch" type="xml"><search><field name="instrument_id"/><field name="channel"/><filter name="valid" string="Valid Measurements" domain="[('valid','=',True),('sampled_at','!=',False)]"/><filter name="last_day" string="Last 24 Hours" domain="[('sampled_at','&gt;=',(datetime.datetime.utcnow()-datetime.timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S'))]"/><filter name="invalid" string="Sensor Errors" domain="[('valid','=',False)]"/><filter name="untimed" string="Clock Not Synchronized" domain="[('sampled_at','=',False)]"/></search></field></record>
    <record id="view_instrument_reading_graph" model="ir.ui.view"><field name="name">iot.instrument.reading.graph</field><field name="model">iot.instrument.reading</field><field name="arch" type="xml"><graph string="Hourly Temperature" type="line"><field name="sampled_at" interval="hour"/><field name="instrument_id"/><field name="channel"/><field name="temperature" type="measure"/></graph></field></record>
    <record id="view_instrument_reading_pivot" model="ir.ui.view"><field name="name">iot.instrument.reading.pivot</field><field name="model">iot.instrument.reading</field><field name="arch" type="xml"><pivot><field name="instrument_id" type="row"/><field name="channel" type="row"/><field name="sampled_at" interval="hour" type="col"/><field name="temperature" type="measure"/></pivot></field></record>
    <record id="view_instrument_reading_list" model="ir.ui.view"><field name="name">iot.instrument.reading.list</field><field name="model">iot.instrument.reading</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="sampled_at"/><field name="instrument_id"/><field name="channel"/><field name="valid"/><field name="temperature"/><field name="target"/><field name="fault"/><field name="demand" optional="hide"/><field name="output"/><field name="communication_pause" optional="hide"/><field name="time_quality" optional="hide"/><field name="device_boot_id" optional="hide"/><field name="device_seq" optional="hide"/><field name="device_uptime_ms" optional="hide"/><field name="received_at" optional="hide"/></list></field></record>
    <record id="view_instrument_alarm_list" model="ir.ui.view"><field name="name">iot.instrument.alarm.list</field><field name="model">iot.instrument.alarm</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="sampled_at"/><field name="received_at"/><field name="instrument_id"/><field name="channel"/><field name="fault"/><field name="time_quality" optional="hide"/><field name="device_boot_id" optional="hide"/><field name="device_seq" optional="hide"/></list></field></record>
    <record id="view_instrument_run_list" model="ir.ui.view"><field name="name">iot.instrument.run.log.list</field><field name="model">iot.instrument.run.log</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="sampled_at"/><field name="received_at" optional="hide"/><field name="instrument_id"/><field name="run_id"/><field name="recipe_uid"/><field name="revision"/><field name="step"/><field name="event"/><field name="message"/><field name="temperature_valid"/><field name="temperature"/><field name="time_quality" optional="hide"/><field name="device_boot_id" optional="hide"/><field name="device_seq" optional="hide"/><field name="device_uptime_ms" optional="hide"/></list></field></record>
    <record id="view_instrument_recipe_form" model="ir.ui.view">
        <field name="name">iot.instrument.recipe.form</field><field name="model">iot.instrument.recipe</field>
        <field name="arch" type="xml"><form class="iot_program_form">
            <header><button name="action_release" type="object" string="Release Program" class="btn-primary" invisible="state != 'draft'" groups="iot_control_center.group_iot_manager"/><button name="action_new_revision" type="object" string="Create New Revision" invisible="state != 'released'" groups="iot_control_center.group_iot_manager"/><field name="state" widget="statusbar"/></header>
            <sheet>
                <div class="oe_button_box" name="button_box"><button name="action_open_washers" type="object" string="Select Target Washer" class="oe_stat_button" icon="fa-download"/></div>
                <field name="active" invisible="1"/>
                <group><field name="name" readonly="state != 'draft'"/><field name="company_id" readonly="state != 'draft'"/><field name="revision" readonly="state != 'draft'"/></group>
                <div class="iot_workflow_strip"><span><b>1</b> Edit steps</span><span><b>2</b> Release Program</span><span><b>3</b> Select Target Washer</span></div>
                <div class="iot_form_hint mb-3">Release the program, then open the target washer to select its download list. Publishing alone does not confirm delivery.</div>
                <p>Fill A and Fill B use pump times saved on each washer. Set them on the device under Device Care / Pump Times before running.</p>
                <field name="step_ids" readonly="state != 'draft'"><list editable="bottom"><field name="sequence" widget="handle"/><field name="kind"/><field name="cycles" invisible="kind != 'wash'"/><field name="duration_s" invisible="kind in ['wait', 'fill_a', 'fill_b'] or (kind == 'wash' and cycles &gt; 0)"/><field name="rps" invisible="kind not in ['wash', 'dry']"/><field name="reverse_s" invisible="kind != 'wash'"/></list></field>
                <details class="iot_help_details"><summary>Program Rules and Motor Settings</summary>
                <p>Publishing automatically adds a homing step at the beginning. Drain before changing buffer or spin drying. Operator waits require local Continue. One wash cycle is forward plus reverse; cycle count times twice the reverse interval determines wash duration.</p>
                <p>Filling duration controls pump-on time, not a measured volume. Calibrate filling and draining times on the actual device. Temperature is recorded only.</p>
                <p>Original motor baseline: inlet and filling overflow at full output; both pumps during drainage 150/255, during spin drying 50/255. New wash steps default to 1 rev/s and spin-dry steps to 10 rev/s. Spindle speed is pulse controlled, not a voltage percentage.</p>
                <p>While waiting, tap NEXT to move through slots 1, 4, 5, 2, 3, 6, then 1. Moves alternate 180 and 60 degrees. All pumps stay off. Check physical balance before pressing Continue; the device cannot detect loaded slides.</p>
                <group><field name="uid" readonly="1"/><field name="checksum" readonly="1"/></group>
                </details>
            </sheet>
        </form></field>
    </record>
    <record id="view_instrument_recipe_list" model="ir.ui.view"><field name="name">iot.instrument.recipe.list</field><field name="model">iot.instrument.recipe</field><field name="arch" type="xml"><list><field name="name"/><field name="revision"/><field name="state"/><field name="company_id"/></list></field></record>
    <record id="view_instrument_recipe_label" model="ir.ui.view">
        <field name="name">iot.instrument.recipe.screen.label</field><field name="model">iot.instrument.recipe</field>
        <field name="inherit_id" ref="view_instrument_recipe_form"/><field name="arch" type="xml">
            <field name="name" position="after"><field name="device_label" readonly="state != 'draft'"/></field>
        </field>
    </record>
    <record id="action_washer_programs" model="ir.actions.act_window"><field name="name">Washer Programs</field><field name="res_model">iot.instrument.recipe</field><field name="view_mode">list,form</field></record>
    <record id="view_instrument_provision" model="ir.ui.view"><field name="name">iot.instrument.provision.form</field><field name="model">iot.instrument.provision</field><field name="arch" type="xml"><form><group><field name="instrument_id" readonly="1"/><field name="token" password="True"/></group><p>Register the random token provisioned locally on this device. Only its hash is kept after registration.</p><footer><button name="action_apply" type="object" string="Register" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
    <record id="view_instrument_release_form" model="ir.ui.view"><field name="name">iot.instrument.release.form</field><field name="model">iot.instrument.release</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id" readonly="id"/><field name="kind" readonly="id"/><field name="hardware" readonly="id"/><field name="filename" invisible="1"/><field name="binary" filename="filename" readonly="id"/><field name="manifest" readonly="id"/></group></sheet></form></field></record>
    <record id="action_instrument_releases" model="ir.actions.act_window"><field name="name">Instrument Firmware</field><field name="res_model">iot.instrument.release</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_buffer_heaters" name="Buffer Heaters" parent="menu_iot_mode_cards" action="action_buffer_heaters" sequence="31" groups="iot_control_center.group_iot_user"/>
    <menuitem id="menu_array_washers" name="Array Washers" parent="menu_iot_mode_cards" action="action_array_washers" sequence="32" groups="iot_control_center.group_iot_user"/>
    <menuitem id="menu_washer_programs" name="Washer Programs" parent="menu_iot_mode_detailed" action="action_washer_programs" sequence="33" groups="iot_control_center.group_iot_user"/>
    <menuitem id="menu_instrument_firmware" name="Instrument Firmware" parent="menu_iot_mode_detailed" action="action_instrument_releases" sequence="34" groups="iot_control_center.group_iot_manager"/>
</odoo>
