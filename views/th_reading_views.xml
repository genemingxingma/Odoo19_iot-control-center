<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iot_th_reading_list" model="ir.ui.view">
        <field name="name">iot.th.reading.list</field>
        <field name="model">iot.th.reading</field>
        <field name="arch" type="xml">
            <list>
                <field name="reported_at"/>
                <field name="sensor_id"/>
                <field name="sensor_location_id"/>
                <field name="sensor_location_detail" optional="show"/>
                <field name="sensor_group_id" optional="show"/>
                <field name="node_id" optional="hide"/>
                <field name="sensor_code" optional="hide"/>
                <field name="temperature"/>
                <field name="humidity"/>
                <field name="temperature_min" optional="hide"/>
                <field name="temperature_max" optional="hide"/>
                <field name="humidity_min" optional="hide"/>
                <field name="humidity_max" optional="hide"/>
                <field name="sample_count" optional="hide"/>
                <field name="is_hourly_rollup" optional="hide"/>
                <field name="is_daily_rollup" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_iot_th_reading_graph" model="ir.ui.view">
        <field name="name">iot.th.reading.graph</field>
        <field name="model">iot.th.reading</field>
        <field name="arch" type="xml">
            <graph string="Temperature/Humidity Trend" type="line">
                <field name="reported_at" interval="hour"/>
                <field name="temperature" type="measure" operator="avg"/>
                <field name="humidity" type="measure" operator="avg"/>
                <field name="sensor_id" type="row"/>
            </graph>
        </field>
    </record>

    <record id="view_iot_th_reading_pivot" model="ir.ui.view">
        <field name="name">iot.th.reading.pivot</field>
        <field name="model">iot.th.reading</field>
        <field name="arch" type="xml">
            <pivot string="Temperature/Humidity Statistics">
                <field name="reported_at" type="col" interval="day"/>
                <field name="sensor_id" type="row"/>
                <field name="temperature" type="measure" operator="avg"/>
                <field name="humidity" type="measure" operator="avg"/>
                <field name="temperature_min" type="measure" operator="min"/>
                <field name="temperature_max" type="measure" operator="max"/>
                <field name="humidity_min" type="measure" operator="min"/>
                <field name="humidity_max" type="measure" operator="max"/>
                <field name="sample_count" type="measure" operator="sum"/>
            </pivot>
        </field>
    </record>

    <record id="view_iot_th_reading_search" model="ir.ui.view">
        <field name="name">iot.th.reading.search</field>
        <field name="model">iot.th.reading</field>
        <field name="arch" type="xml">
            <search>
                <field name="node_id"/>
                <field name="sensor_id"/>
                <field name="sensor_code"/>
                <field name="sensor_location_id"/>
                <field name="sensor_location_detail"/>
                <field name="sensor_group_id"/>
                <field name="gateway_id"/>
                <filter name="iot_reported_at" string="Reported At" date="reported_at"/>
                <separator/>
                <filter name="iot_last_5_days" string="Last 5 Days"
                        domain="[('reported_at', '>=', (context_today() - datetime.timedelta(days=5)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="iot_last_30_days" string="Last 30 Days"
                        domain="[('reported_at', '>=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter name="iot_hourly_avg" string="Hourly Average"
                        domain="[('is_hourly_rollup', '=', False), ('is_daily_rollup', '=', False)]"
                        context="{'iot_time_mode': 'hour'}"/>
                <filter name="iot_daily_avg" string="Daily Overview"
                        domain="[('is_hourly_rollup', '=', False)]"
                        context="{'iot_time_mode': 'day'}"/>
                <filter name="iot_node_frequency" string="Raw Samples"
                        domain="[('is_hourly_rollup', '=', False), ('is_daily_rollup', '=', False)]"
                        context="{'iot_time_mode': 'raw'}"/>
                <group expand="0" string="Group By">
                    <filter name="group_sensor" string="Sensor" context="{'group_by': 'sensor_id'}"/>
                    <filter name="group_location" string="Location" context="{'group_by': 'sensor_location_id'}"/>
                    <filter name="group_sensor_group" string="Sensor Group" context="{'group_by': 'sensor_group_id'}"/>
                    <filter name="group_gateway" string="Gateway" context="{'group_by': 'gateway_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_iot_th_reading" model="ir.actions.act_window">
        <field name="name">Monitoring &amp; Analysis</field>
        <field name="res_model">iot.th.reading</field>
        <field name="view_mode">graph,list,pivot</field>
        <field name="search_view_id" ref="view_iot_th_reading_search"/>
        <field name="domain">[('company_id', '!=', False)]</field>
        <field name="context">{'graph_mode': 'line', 'graph_measure': 'temperature', 'graph_stacked': False, 'graph_cumulated': False, 'iot_time_mode': 'hour', 'search_default_iot_hourly_avg': 1, 'search_default_iot_last_5_days': 1}</field>
    </record>

    <menuitem id="menu_iot_th_reading" name="Monitoring &amp; Analysis" parent="menu_iot_environment_root" action="action_iot_th_reading" sequence="30" groups="base.group_erp_manager"/>
</odoo>
